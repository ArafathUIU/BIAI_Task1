# Copy to .env and fill in ONE provider. Never commit .env.
#
# Provider precedence (first match wins):
#   1) LLM_BASE_URL  -> Ollama / any OpenAI-compatible endpoint
#   2) GROQ_API_KEY  -> Groq
#   3) OPENAI_API_KEY -> OpenAI
# If both GROQ_API_KEY and OPENAI_API_KEY are set, Groq is used.

# --- OpenAI ---
OPENAI_API_KEY=
# Model used for OpenAI (and for LLM_BASE_URL / Ollama):
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0

# --- Groq (OpenAI-compatible) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Ollama / custom OpenAI-compatible endpoint ---
# Example: LLM_BASE_URL=http://localhost:11434/v1
LLM_BASE_URL=
LLM_API_KEY=
# When using Ollama, set LLM_MODEL to a local tag, e.g. qwen2.5:7b-instruct

# --- Behaviour ---
CONFIDENCE_THRESHOLD=0.80   # soft secondary gate only

# --- Optional tracing ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
