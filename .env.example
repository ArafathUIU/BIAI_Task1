# Copy to .env and fill in. Never commit .env.

# --- OpenAI (default for the scored demo) ---
OPENAI_API_KEY=

# --- Ollama / OpenAI-compatible fallback (leave OPENAI_API_KEY empty to use) ---
LLM_BASE_URL=          # e.g. http://localhost:11434/v1
LLM_MODEL=gpt-4o-mini  # or an Ollama tag such as qwen2.5:7b-instruct
LLM_TEMPERATURE=0

# --- Behaviour ---
CONFIDENCE_THRESHOLD=0.80   # soft secondary gate only

# --- Optional tracing ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
